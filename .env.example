# ---- Database (Neon Postgres) ----
# Pooled connection — used by serverless functions at runtime.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/aquavia?sslmode=require&pgbouncer=true&connection_limit=1"
# Unpooled connection — used by `prisma migrate` only.
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/aquavia?sslmode=require"

# ---- Admin ----
# Single shared password for the analytics dashboard.
ADMIN_PASSWORD="change-me"
# Secret used to sign the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=""

# ---- Cron ----
# Vercel sends this automatically as `Authorization: Bearer $CRON_SECRET`.
# The cron routes FAIL CLOSED if this is unset — they will not run open.
CRON_SECRET=""

# ---- Lead forwarding ----
# Moved off the client. The old key was committed in plaintext at src/App.jsx:3
# and must be ROTATED before deploying this.
WEB3FORMS_KEY=""

# ---- Retention ----
# Raw events are truth for this many days; rollups are kept forever.
EVENT_RETENTION_DAYS="90"

# ---- AI insights (optional) ----
# Without this the insights layer degrades to templated prose rather than failing.
ANTHROPIC_API_KEY=""
