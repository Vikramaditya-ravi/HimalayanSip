{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,

    // App.jsx is 1734 lines of plain JS and stays that way. `allowJs` lets TS
    // resolve imports from it; `checkJs: false` means we do not type-check it.
    // The compile-error guarantee for tracking calls therefore covers TS call
    // sites only — calls from App.jsx are covered by the catalog-scan test in
    // src/analytics/__tests__/catalog-usage.test.ts.
    "allowJs": true,
    "checkJs": false,

    "types": ["node", "vite/client", "vitest/globals"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "lib/**/*.ts", "api/**/*.ts", "middleware.js"],
  "exclude": ["node_modules", "dist", "src/components", "src/hooks"]
}
